{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx", "node_modules/expo-location/build/**/*.d.ts"],
  "exclude": ["node_modules"]
}
