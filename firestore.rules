rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Urban Helpers — Firestore Security Rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ── bookings ──────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // ── vendors ────────────────────────────────────────────────────────────────
    match /vendors/{vendorId} {
      allow read, write: if true;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }

    // ── serviceCategories ─────────────────────────────────────────────────────
    match /serviceCategories/{docId} {
      allow read, write: if true;
    }

    match /pricing_rules/{docId} {
      allow read, write: if true;
    }

    // ── shop_products ─────────────────────────────────────────────────────────
    match /shop_products/{docId} {
      allow read, write: if true;
    }

    // ── shop_orders ───────────────────────────────────────────────────────────
    match /shop_orders/{docId} {
      allow read, write: if true;
    }

    // ── sos_alerts ────────────────────────────────────────────────────────────
    match /sos_alerts/{docId} {
      allow read, write: if true;
    }

    // ── complaints ────────────────────────────────────────────────────────────
    match /complaints/{docId} {
      allow read, write: if true;
    }

    // ── fitness_videos ────────────────────────────────────────────────────────
    match /fitness_videos/{docId} {
      allow read, write: if true;
    }

    // ── health_logs ───────────────────────────────────────────────────────────
    match /health_logs/{docId} {
      allow read, write: if true;
    }

    // ── health_records ────────────────────────────────────────────────────────
    match /health_records/{docId} {
      allow read, write: if true;
    }

    // ── Catch-all ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
