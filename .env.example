# Firebase web config (from Firebase console > Project settings > Your apps > Web app).
# These values are not secret — access is enforced by Firestore security rules —
# but keep this file out of git anyway and copy it to .env with real values.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Firebase console > Authentication > Sign-in method > Google,
# and Google Cloud Console > APIs & Services > Credentials for the Android client).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
