{
  "expo": {
    "name": "Urban Captain",
    "slug": "urban-captain-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D3325"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#10B981",
          "defaultChannel": "urgent-orders"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Urban Captain needs your location to show customers where you are.",
          "locationWhenInUsePermission": "Urban Captain needs your location to navigate to customers."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.urbancaptain.vendor",
      "buildNumber": "1.0.0",
      "config": {
        "googleMapsApiKey": "AIzaSyAMzsDmDdT2c7r5j1dWTSxev6XSHJZTf-s"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Urban Captain needs your location to navigate to customers.",
        "NSLocationAlwaysUsageDescription": "Urban Captain uses your location to show customers where you are.",
        "NSCameraUsageDescription": "Urban Captain needs camera access to upload your profile photo.",
        "NSMicrophoneUsageDescription": "Urban Captain records audio during service for transparency and safety.",
        "UIBackgroundModes": [
          "audio",
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D3325"
      },
      "package": "com.urbancaptain.vendor",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAMzsDmDdT2c7r5j1dWTSxev6XSHJZTf-s"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}