# Urban Helpers — Fastfile
# Builds unsigned IPA for AltStore / Sideloadly installation
# No Apple Developer account needed — 100% FREE
#
# AltStore will re-sign the IPA with your free Apple ID when it installs.

default_platform(:ios)

platform :ios do

  # ─── Build unsigned IPA for AltStore ─────────────────────────────────────────
  desc "Build unsigned IPA — install via AltStore (free, no Apple Dev account)"
  lane :altstore do

    # Step 1: Generate native iOS Xcode project from Expo config (free, local)
    Dir.chdir("..") do
      sh("npx expo prebuild --platform ios --no-install --clean")
    end

    # Step 2: Build with Xcode — skip all code signing
    build_app(
      workspace:        "ios/UrbanHelpers.xcworkspace",
      scheme:           "UrbanHelpers",
      configuration:    "Release",
      output_directory: "./build",
      output_name:      "UrbanHelpers.ipa",
      clean:            true,
      skip_codesigning: true,
      xcargs:           "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY='' CODE_SIGNING_IDENTITY=''",
      export_method:    "development"
    )

    puts ""
    puts "================================================================"
    puts "✅  IPA built: ios_app/build/UrbanHelpers.ipa"
    puts ""
    puts "📱  To install on iPhone via AltStore:"
    puts "    1. Download AltServer on your PC from altstore.io (free)"
    puts "    2. Run AltServer, plug iPhone in USB once to trust"
    puts "    3. After that — WiFi only, no cable needed"
    puts "    4. Open AltStore on iPhone → My Apps → +"
    puts "    5. Pick UrbanHelpers.ipa → installs in seconds ✅"
    puts "    (AltStore auto-refreshes every 7 days via background WiFi)"
    puts "================================================================"
  end

end
